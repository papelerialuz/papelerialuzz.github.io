*{
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
}

body{
    background-color: white;
}

.card-container{
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 100px;
}

.card{
    width: 325px;
    background-color: white;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0px 2px 4px rgba(0,0,0,0.2);
}

.card img{
    width: 100px;
    height: auto;
}

.card-content{
    padding: 14px;
}

.card-content h3{
    font-size: 25px;
    margin-bottom: 8px;
}

.card-content p{
    color: black;
    font-size: 15px;
    line-height: 1.3;
}

.card-content .btn{
    display: inline-backq;
    padding: 8px 16px;
    background-color: #333;
    text-decoration: none;
    border-radius: 16px;
    margin-top: 16px;
    color: #fff;
}